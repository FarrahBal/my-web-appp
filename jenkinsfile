pipeline {
    agent any

    stages {
        stage('Clone') {
            steps {
                checkout scm
            }
        }
        stage('Install') {
            steps {
                echo 'Checking environment and dependencies...'
                sh 'node -v || true'
                sh 'ls -la'
            }
        }
        stage('Test') {
            steps {
                echo 'Running tests...'
                sh 'echo "Test stage passed on Linux container"'
            }
        }
        stage('Build') {
            steps {
                echo 'Building the web application...'
                sh 'pwd'
            }
        }
    }
}